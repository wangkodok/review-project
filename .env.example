# TODO: Generate a secure NextAuth secret.
AUTH_SECRET=

# TODO: Add Google OAuth client ID.
AUTH_GOOGLE_ID=

# TODO: Add Google OAuth client secret.
AUTH_GOOGLE_SECRET=

# TODO: Enable Kakao authentication only after its OAuth settings are ready.
AUTH_KAKAO_ENABLED=false

# TODO: Add the Kakao REST API key.
AUTH_KAKAO_ID=

# TODO: Add the Kakao client secret. Server-side only.
AUTH_KAKAO_SECRET=

# TODO: Keep Kakao account event ingestion disabled until Production observe-only QA.
AUTH_KAKAO_ACCOUNT_EVENTS_ENABLED=false

# TODO: Add the application URL.
AUTH_URL=

# TODO: Add Supabase project URL.
SUPABASE_URL=

# TODO: Add Supabase anon key.
SUPABASE_ANON_KEY=

# TODO: Add Supabase service role key. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# TODO: Add the Upstash Redis REST endpoint. Server-side only.
UPSTASH_REDIS_REST_URL=

# TODO: Add the Upstash Redis REST token. Server-side only.
UPSTASH_REDIS_REST_TOKEN=

# TODO: Generate a dedicated random secret with at least 32 characters for opaque Rate Limit identifiers. Server-side only.
RATE_LIMIT_IDENTIFIER_SECRET=

# TODO: Keep review image uploads disabled until server API, cleanup worker, UI, and Production QA are complete.
REVIEW_IMAGE_UPLOAD_ENABLED=false

# TODO: Add the Cloudflare account identifier used by the server-only R2 client.
R2_ACCOUNT_ID=

# TODO: Add the exact server-only R2 S3 endpoint for the Cloudflare account.
R2_ENDPOINT=

# TODO: Add the server-only R2 access key restricted to the two review image buckets.
R2_ACCESS_KEY_ID=

# TODO: Add the matching server-only R2 secret access key.
R2_SECRET_ACCESS_KEY=

# TODO: Add the private temporary review image bucket name.
R2_TEMP_BUCKET_NAME=

# TODO: Add the public delivery review image bucket name. Public delivery remains disabled until separately approved.
R2_PUBLIC_BUCKET_NAME=

# TODO: Add the HTTPS base URL used to deliver validated public review images.
REVIEW_IMAGE_PUBLIC_BASE_URL=

# TODO: Generate a dedicated random secret of 32-256 characters for authenticated Vercel Cron requests. Server-side only.
CRON_SECRET=
